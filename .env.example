# Server Configuration
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
SERVE_CLIENT_DIST=false

# Storage & Cache (SQLite via Node 24 built-in node:sqlite)
DATABASE_PATH=./server/data/mw4trackstats.sqlite
IMAGES_DIR=./server/data/images
CACHE_TTL_MINUTES=30

# X (Twitter) Access Provider: api | mock | playwright
# Recommended live mode: "api" (Official X API v2 — verify keys with "npm run x:verify"). Use "mock" for local demo.
X_PROVIDER=mock
X_BOT_HANDLE=CODCombatRecord
X_PINNED_TWEET_URL=https://x.com/CODCombatRecord/status/2122766555675328664
X_COOLDOWN_MS=2000
X_REPLY_TIMEOUT_MS=45000
X_POLL_INTERVAL_MS=1500

# Playwright Browser Automation (optional fallback when X_PROVIDER=playwright)
# Run "npm run x:login" once to sign in and save persistent browser session
PLAYWRIGHT_USER_DATA_DIR=./server/data/playwright-profile
PLAYWRIGHT_HEADLESS=true

# Official X API v2 Credentials (when X_PROVIDER=api)
# OAuth 1.0a User Context (Read and Write) is used for server fallback;
# OAuth 2.0 PKCE lets each public visitor sign in with X so queries use their own @CODCombatRecord daily quota.
X_API_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_REDIRECT_URI=http://127.0.0.1:3001/callback
SESSION_COOKIE_SECURE=false

# Image Parsing (OCR / Vision): gemini | tesseract | mock
# When PARSER_PROVIDER=gemini without GEMINI_API_KEY, falls back automatically to mock (in mock X mode) or tesseract
PARSER_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Public Site IP Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_UNCACHED=5
RATE_LIMIT_MAX_READS=60

# Google Sheets Feedback Webhook (see docs/google-sheets-feedback.gs)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
